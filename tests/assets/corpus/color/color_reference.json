  "linear_light": {
    "oracle": "Pillow 'F' mode resampling (32-bit float) of premultiplied linear-light channels; source-over in double precision",
    "max_abs": 1,
    "cases": {
      "photo_alpha_down": {
        "op": "resize",
        "input": "photo_alpha.png",
        "width": 67,
        "height": 53,
        "filter": "lanczos",
        "reference": "linear_photo_alpha_down.png"
      },
      "photo_alpha_up": {
        "op": "resize",
        "input": "photo_alpha.png",
        "width": 311,
        "height": 243,
        "filter": "bicubic",
        "reference": "linear_photo_alpha_up.png"
      },
      "graphic_alpha_down": {
        "op": "resize",
        "input": "graphic_alpha.png",
        "width": 40,
        "height": 30,
        "filter": "bilinear",
        "reference": "linear_graphic_alpha_down.png"
      },
      "odd_alpha_box": {
        "op": "resize",
        "input": "odd_alpha.png",
        "width": 30,
        "height": 77,
        "filter": "box",
        "reference": "linear_odd_alpha_box.png"
      },
      "photo_hamming": {
        "op": "resize",
        "input": "photo.png",
        "width": 100,
        "height": 75,
        "filter": "hamming",
        "reference": "linear_photo_hamming.png"
      },
      "checker_half": {
        "op": "resize",
        "input": "checker",
        "width": 8,
        "height": 8,
        "filter": "box",
        "reference": "linear_checker_half.png"
      },
      "graphic_over_photo": {
        "op": "composite",
        "input": "photo.png",
        "overlay": "graphic_alpha.png",
        "x": 30,
        "y": 20,
        "opacity": 1.0,
        "reference": "linear_graphic_over_photo.png"
      },
      "odd_over_photo_alpha": {
        "op": "composite",
        "input": "photo_alpha.png",
        "overlay": "odd_alpha.png",
        "x": -10,
        "y": 70,
        "opacity": 0.6,
        "reference": "linear_odd_over_photo_alpha.png"
      }
    }
