<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- TUnit0046 asks for Func<T> data sources for reference-type arguments; the tests never mutate their inputs. -->
    <NoWarn>$(NoWarn);CA1707;TUnit0046</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.72.16" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Assertions.Enums" />
    <ProjectReference Include="..\..\src\PictureSharp\PictureSharp.csproj" />
  </ItemGroup>

</Project>
