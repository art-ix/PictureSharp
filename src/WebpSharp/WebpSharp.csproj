<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>WebpSharp</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageId>WebpSharp</PackageId>
    <Description>Pure C# image library for .NET 10: WebP decoding (lossy, lossless, alpha, animation), static WebP encoding, PNG/BMP/JPEG reading and writing, metadata and pixel access. No native dependencies.</Description>
    <PackageTags>webp;image;png;jpeg;codec;encoder;decoder</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WebpSharp.Tests" />
    <InternalsVisibleTo Include="WebpSharp.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
