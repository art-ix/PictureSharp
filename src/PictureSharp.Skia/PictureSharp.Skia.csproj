<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../PictureSharp.Adapters.props" />

  <PropertyGroup>
    <RootNamespace>PictureSharp.Skia</RootNamespace>
    <PackageId>PictureSharp.Skia</PackageId>
    <Description>Copies PictureSharp images to and from SkiaSharp SKBitmap, SKImage and SKPixmap with an explicit alpha policy.</Description>
    <PackageReleaseNotes>First release: copies Image and ImageFrame to SKBitmap/SKImage (Rgba8888 or Bgra8888, Unpremul or Premul) and reads SKBitmap, SKPixmap and SKImage of any color type with straight alpha. Notes: https://github.com/art-ix/PictureSharp/blob/v0.6.4/docs/releases/release-0.6.4.md</PackageReleaseNotes>
    <PackageTags>picturesharp;image;skiasharp;skia;skbitmap;interop</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

</Project>
