<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../PictureSharp.Adapters.props" />

  <PropertyGroup>
    <RootNamespace>PictureSharp.Drawing</RootNamespace>
    <PackageId>PictureSharp.Drawing</PackageId>
    <Description>Copies PictureSharp images to and from System.Drawing.Bitmap (Windows).</Description>
    <PackageReleaseNotes>0.7.13: unchanged adapter, released with PictureSharp 0.7.13 (automatic film frames for DevelopNegative). Notes: https://github.com/art-ix/PictureSharp/blob/v0.7.13/docs/releases/release-0.7.13.md</PackageReleaseNotes>
    <PackageTags>picturesharp;image;system.drawing;bitmap;gdi+;interop</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

</Project>
