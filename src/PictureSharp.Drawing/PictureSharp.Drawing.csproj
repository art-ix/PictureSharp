<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../PictureSharp.Adapters.props" />

  <PropertyGroup>
    <RootNamespace>PictureSharp.Drawing</RootNamespace>
    <PackageId>PictureSharp.Drawing</PackageId>
    <Description>Copies PictureSharp images to and from System.Drawing.Bitmap (Windows).</Description>
    <PackageReleaseNotes>0.9.0: 16-bit image processing, PNG read/write, typed pixel access and updated adapters. Breaking pixel API and plugin API changes; normalized settings use 0-1. Migration: https://github.com/art-ix/PictureSharp/blob/v0.9.0/docs/migration-from-0.8.md</PackageReleaseNotes>
    <PackageTags>picturesharp;image;system.drawing;bitmap;gdi+;interop</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

</Project>
