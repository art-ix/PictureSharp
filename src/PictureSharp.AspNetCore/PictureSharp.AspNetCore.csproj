<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../PictureSharp.Adapters.props" />

  <PropertyGroup>
    <RootNamespace>PictureSharp.AspNetCore</RootNamespace>
    <PackageId>PictureSharp.AspNetCore</PackageId>
    <Description>Returns PictureSharp images from ASP.NET Core endpoints with Accept-based WebP/PNG/JPEG negotiation, and reads uploaded images with size limits and request cancellation.</Description>
    <PackageReleaseNotes>0.8.4 ships a 128×128 package icon instead of the full-size image, cutting package sizes (PictureSharp 1.09 MB to 0.63 MB, adapters about 0.49 MB to 0.03 MB). No API or image-processing changes. Notes: https://github.com/art-ix/PictureSharp/blob/v0.8.4/docs/releases/release-0.8.4.md</PackageReleaseNotes>
    <PackageTags>picturesharp;image;aspnetcore;minimal-api;iresult;webp;content-negotiation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
