<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../PictureSharp.Adapters.props" />

  <PropertyGroup>
    <RootNamespace>PictureSharp.AspNetCore</RootNamespace>
    <PackageId>PictureSharp.AspNetCore</PackageId>
    <Description>Returns PictureSharp images from ASP.NET Core endpoints with Accept-based WebP/PNG/JPEG negotiation, and reads uploaded images with size limits and request cancellation.</Description>
    <PackageReleaseNotes>0.9.0: 16-bit image processing, PNG read/write, typed pixel access and updated adapters. Breaking pixel API and plugin API changes; normalized settings use 0-1. Migration: https://github.com/art-ix/PictureSharp/blob/v0.9.0/docs/migration-from-0.8.md</PackageReleaseNotes>
    <PackageTags>picturesharp;image;aspnetcore;minimal-api;iresult;webp;content-negotiation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
