<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../PictureSharp.Adapters.props" />

  <PropertyGroup>
    <RootNamespace>PictureSharp.AspNetCore</RootNamespace>
    <PackageId>PictureSharp.AspNetCore</PackageId>
    <Description>Returns PictureSharp images from ASP.NET Core endpoints with Accept-based WebP/PNG/JPEG negotiation, and reads uploaded images with size limits and request cancellation.</Description>
    <PackageReleaseNotes>First release: Results.Extensions.Image / ImageResult with Accept negotiation (WebP, PNG, JPEG), Content-Length, Vary, Cache-Control, HEAD, optional 406 and RequestAborted; HttpRequest.ReadImageAsync with a 413 size limit. Notes: https://github.com/art-ix/PictureSharp/blob/v0.6.4/docs/releases/release-0.6.4.md</PackageReleaseNotes>
    <PackageTags>picturesharp;image;aspnetcore;minimal-api;iresult;webp;content-negotiation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
