<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PictureSharp</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageId>PictureSharp</PackageId>
    <Description>A pure managed image processing library for .NET. No native dependencies.</Description>
    <PackageReleaseNotes>0.8.0 lets format plugins write HDR gain maps: image.GetGainMap() hands an encoder the attached map (EncodableGainMap: metadata and the map in the geometry of the current pixels, or the plugin's own instance when unedited), GainMapMetadata.ToIso() and ToAlternateIcc() write ISO 21496-1 metadata and the primaries profile as libultrahdr does, and JPEG with JpegGainMapMode.Preserve or Require now also writes maps attached by plugins (for example HEIC to Ultra HDR JPEG). Existing files and outputs are unchanged. Notes: https://github.com/art-ix/PictureSharp/blob/v0.8.0/docs/releases/release-0.8.0.md</PackageReleaseNotes>
    <PackageTags>webp;image;png;jpeg;bmp;gif;pcx;ico;codec;encoder;decoder;resize;thumbnail</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/art-ix/PictureSharp</PackageProjectUrl>
    <!-- README links are absolute so they also work on nuget.org. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PictureSharp.Tests" />
    <InternalsVisibleTo Include="PictureSharp.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Update="build/PictureSharp.targets" Pack="true" PackagePath="build/PictureSharp.targets" />
  </ItemGroup>

</Project>
