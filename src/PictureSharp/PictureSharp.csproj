<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PictureSharp</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageId>PictureSharp</PackageId>
    <Description>A pure managed image processing library for .NET. No native dependencies.</Description>
    <PackageReleaseNotes>0.7.5 makes lossy WebP faster (about 30% faster encoding and 8–11% faster decoding on one thread) and the load, orient, convert to sRGB, resize and save path about 40% faster with fewer allocations; it also fixes rare run-to-run differences in multi-threaded lossy WebP encoding. Decoded pixels, encoded bytes and processing results are otherwise unchanged; no public API changes. Notes: https://github.com/art-ix/PictureSharp/blob/v0.7.5/docs/releases/release-0.7.5.md</PackageReleaseNotes>
    <PackageTags>webp;image;png;jpeg;bmp;gif;pcx;ico;codec;encoder;decoder;resize;thumbnail</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/art-ix/PictureSharp</PackageProjectUrl>
    <!-- README links are absolute so they also work on nuget.org. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PictureSharp.Tests" />
    <InternalsVisibleTo Include="PictureSharp.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Update="build/PictureSharp.targets" Pack="true" PackagePath="build/PictureSharp.targets" />
  </ItemGroup>

</Project>
