<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PictureSharp</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageId>PictureSharp</PackageId>
    <Description>A pure managed image processing library for .NET. No native dependencies.</Description>
    <PackageReleaseNotes>0.7.10 adds JpegDecoderOptions.CmykStorage (DecoderOptions.Jpeg) to read four-component JPEG values as plain ink amounts, as TIFF stores CMYK, and an ImageDecodeContext.DecodeEmbeddedPart overload with EmbeddedPartOptions (JPEG settings and degree of parallelism of one part). Existing API and results unchanged. Notes: https://github.com/art-ix/PictureSharp/blob/v0.7.10/docs/releases/release-0.7.10.md</PackageReleaseNotes>
    <PackageTags>webp;image;png;jpeg;bmp;gif;pcx;ico;codec;encoder;decoder;resize;thumbnail</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/art-ix/PictureSharp</PackageProjectUrl>
    <!-- README links are absolute so they also work on nuget.org. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PictureSharp.Tests" />
    <InternalsVisibleTo Include="PictureSharp.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Update="build/PictureSharp.targets" Pack="true" PackagePath="build/PictureSharp.targets" />
  </ItemGroup>

</Project>
